# ===== LLM (required) — get free key at https://aistudio.google.com =====
GOOGLE_API_KEY=paste-your-gemini-key-here
# lite has a generous free daily quota; gemini-flash-latest is ~20 req/day free
GEMINI_MODEL=gemini-flash-lite-latest

# ===== Our own API auth — any strong random string; clients send it as X-API-Key =====
SERVICE_API_KEY=dev-secret-key

# ===== LangSmith tracing/evaluation (recommended) — https://smith.langchain.com =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-research

# ===== Web search (optional) — https://tavily.com ; empty = free DuckDuckGo fallback =====
TAVILY_API_KEY=

# ===== GCP (fill in Phase 9; empty = local file fallbacks, everything still works) =====
GCP_PROJECT_ID=
GCS_BUCKET=
BQ_DATASET=agent_analytics
BQ_TABLE=requests

# ===== Service URLs (docker-compose/k8s override these automatically) =====
MCP_SERVER_URL=http://localhost:8100/mcp
RAG_SERVICE_URL=http://localhost:8001
